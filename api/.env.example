APP_ENV=development
FRONTEND_URL=http://localhost:5173
# Em produção, autorizar também o host www:
# FRONTEND_ALT_URL=https://www.somdaigreja.com.br
# Credenciais reais apenas em api/.env (ignorado pelo Git).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=SUBSTITUIR_POR_HASH_BCRYPT
JWT_SECRET=SUBSTITUIR_POR_SEGREDO_ALEATORIO_COM_32_OU_MAIS_CARACTERES

DB_HOST=localhost
DB_PORT=3306
DB_NAME=plataforma_soni
DB_USER=soni_app
DB_PASSWORD=SUBSTITUIR_SOMENTE_NO_ENV_LOCAL

# Endereço válido de remetente no MTA/sendmail do servidor PHP.
# O envio depende de mail() / sendmail configurado (por exemplo, Mailcow como relay).
SONI_MAIL_FROM=resultados@somdaigreja.com.br
