{
  "name": "kriale/plataforma-soni-api",
  "description": "API Slim 4 da Plataforma SONI",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "slim/slim": "^4.14",
    "slim/psr7": "^1.7",
    "vlucas/phpdotenv": "^5.6",
    "firebase/php-jwt": "^7.2.1",
    "ext-pdo_mysql": "*"
  },
  "autoload": {
    "psr-4": {
      "Soni\\": "src/"
    }
  },
  "scripts": {
    "start": "php -S localhost:8282 -t public public/index.php",
    "db:migrate": "@php bin/migrate.php",
    "db:check": "@php bin/db-check.php",
    "db:backup": "@php bin/backup.php",
    "media:audit": "@php bin/media-audit.php"
  }
}
