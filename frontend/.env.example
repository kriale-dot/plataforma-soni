# No desenvolvimento, o proxy Vite encaminha /api à API Slim na porta 8282.
# Em produção (domínios separados), ajuste esta URL para a API pública, ex. https://api.exemplo.com/api
VITE_API_BASE_URL=/api

# Para o frontend em somdaigreja.com.br e API em subdomínio, configurar antes do build:
# VITE_API_BASE_URL=https://api.somdaigreja.com.br/api
